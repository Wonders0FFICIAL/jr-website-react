# Formspree endpoints (https://formspree.io). Set these in Vercel too, then redeploy.
VITE_WAITLIST_ENDPOINT=
VITE_CONTACT_ENDPOINT=
# Public URL of the Nook bot's dashboard API (the Railway domain), no trailing slash.
# Set this in Vercel → Project → Settings → Environment Variables, then redeploy.
VITE_NOOK_API_URL=https://your-bot.up.railway.app