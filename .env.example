# Where the forms send their data. Both expect a Formspree-style endpoint
# (POST, JSON, `Accept: application/json`), e.g. https://formspree.io/f/xxxxxxxx
# Copy this file to .env.local for local dev, and add the same two variables
# in Vercel: Project Settings -> Environment Variables.
VITE_WAITLIST_ENDPOINT=
VITE_CONTACT_ENDPOINT=
