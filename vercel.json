{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/nook",
      "destination": "/nook/dashboard",
      "permanent": false
    },
    {
      "source": "/nook/",
      "destination": "/nook/dashboard",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/waitlist",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/waitlist",
      "permanent": true
    },
    {
      "source": "/profile-setup",
      "destination": "/waitlist",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/settings",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/settings/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/nook/dashboard/:path+",
      "destination": "/nook/dashboard/index.html"
    }
  ]
}
